---
import { render } from 'astro:content';
import Base from './Base.astro';
import Sidebar from '@components/Sidebar.astro';
import CompleteRow from '@components/CompleteRow.astro';
import {
  getAllDocs,
  getDocsFor,
  getNeighbors,
  sortLessons,
  toVM,
  type Doc,
  type AnyDoc,
} from '@lib/content';
import { levelById, moduleById, withBase, ui, type Locale } from '@consts';

interface Props {
  entry: AnyDoc;
  lang?: Locale;
}

const { entry, lang = 'tr' } = Astro.props;
const t = ui(lang);
const { Content, headings } = await render(entry);
const vm = toVM(entry, lang);
const docs = (await getDocsFor(lang)) as Doc[];
const { prev, next } = getNeighbors(docs, entry.id);
const level = levelById(entry.data.level);
const moduleMeta = moduleById(entry.data.module);
const totalLessons = sortLessons(docs).length;
const lessonIndex = sortLessons(docs).findIndex((d) => d.id === entry.id) + 1;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const nameOf = (m: { name: string; nameEn: string }) => (lang === 'en' ? m.nameEn : m.name);

// Dil değiştirici: tr dersin en karşılığı var mı? (veya tersi)
const altLangUrl = lang === 'en' ? withBase(`/ders/${entry.id}/`) : withBase(`/en/ders/${entry.id}/`);
const homeUrl = withBase(lang === 'en' ? '/en/' : '/');
const levelUrl = withBase(lang === 'en' ? `/en/#seviye-${vm.level}` : `/#seviye-${vm.level}`);
---

<Base title={vm.title} description={vm.description} lang={lang} altLangUrl={altLangUrl}>
  <div class="shell">
    <Sidebar lang={lang} />
    <main class="content">
      <article>
        <header class="lesson-header">
          <div class="breadcrumbs">
            <a href={homeUrl}>{t.home}</a>
            <span aria-hidden="true">›</span>
            <a href={levelUrl}>{lang === 'en' ? level?.nameEn : level?.name}</a>
            <span aria-hidden="true">›</span>
            <span>{lang === 'en' ? moduleMeta?.nameEn : moduleMeta?.name}</span>
          </div>
          <span class="level-badge" style={`background:${level?.color}`}>
            {level?.emoji} {lang === 'en' ? level?.nameEn : level?.name}
          </span>
          <h1>{vm.title}</h1>
          <p class="lesson-desc">{vm.description}</p>
          <div class="lesson-meta">
            <span>{t.minutes.replace('{d}', String(vm.duration))}</span>
            <span>{t.lessonOf.replace('{i}', String(lessonIndex)).replace('{t}', String(totalLessons))}</span>
            {vm.tags.length > 0 && <span>🏷 {vm.tags.join(', ')}</span>}
          </div>
          {
            vm.id.endsWith('/ozet') && (
              <div style="margin-top: 14px">
                <button type="button" class="print-btn" onclick="window.print()">
                  🖨 {t.printBtn}
                </button>
              </div>
            )
          }
        </header>

        {
          vm.objectives.length > 0 && (
            <div class="objectives">
              <h2>{t.objectives}</h2>
              <ul>
                {vm.objectives.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
            </div>
          )
        }

        {
          toc.length >= 3 && (
            <nav class="toc" aria-label={t.toc}>
              <h2>{t.toc}</h2>
              <ul>
                {toc.map((h) => (
                  <li class:list={[`toc-d${h.depth}`]}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <div class="prose">
          <Content />
        </div>

        <CompleteRow lessonId={vm.id} lang={lang} />

        <nav class="pager" aria-label="Ders gezinmesi">
          {
            prev ? (
              <a href={prev.url} class="prev">
                <span class="pg-label">{t.prev}</span>
                <span class="pg-title">{prev.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next ? (
              <a href={next.url} class="next">
                <span class="pg-label">{t.next}</span>
                <span class="pg-title">{next.title}</span>
              </a>
            ) : (
              <span />
            )
          }
        </nav>
      </article>
    </main>
  </div>
</Base>
