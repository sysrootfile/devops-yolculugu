---
import Base from '@layouts/Base.astro';
import { extractQuizzes } from '@lib/quiz-extract';
import { withBase, levelById } from '@consts';

const quizzes = extractQuizzes().sort((a, b) =>
  a.lessonId.localeCompare(b.lessonId, 'tr')
);
const totalQuestions = quizzes.reduce((sum, q) => sum + q.questions.length, 0);
---

<Base title="Eğitmen Cevap Anahtarı" description="Tüm quiz sorularının doğru cevapları ve açıklamaları — eğitmenler için tek sayfa.">
  <section class="hero" style="padding: 40px 24px 24px;">
    <div class="hero-emoji" aria-hidden="true">🎓</div>
    <h1>Eğitmen Cevap Anahtarı</h1>
    <p>
      <strong>{quizzes.length} quiz · {totalQuestions} soru</strong> — tüm derslerin doğru
      cevapları ve açıklamaları tek sayfada. Bu sayfa eğitmenler ve kontrol için:
      önce kendin çözmeyi dene 🙂
    </p>
    <div class="hero-actions">
      <a class="btn-ghost" href={withBase('/')}>← Ana Sayfa</a>
      <button type="button" class="print-btn" onclick="window.print()">🖨 Yazdır</button>
    </div>
  </section>

  <section class="egitmen" aria-label="Cevap anahtarı">
    {
      quizzes.map((quiz) => {
        const level = levelById(quiz.level);
        return (
          <div class="quiz-block">
            <h2>
              <a href={withBase(`/ders/${quiz.lessonId}/`)}>{quiz.lessonTitle}</a>
            </h2>
            <div class="qb-meta">
              <span class="level-badge" style={`background:${level?.color}`}>
                {level?.emoji} {level?.name}
              </span>
              <span>✅ {quiz.title} · {quiz.questions.length} soru</span>
            </div>
            <ol>
              {quiz.questions.map((question) => (
                <li>
                  <p class="qq">{question.q}</p>
                  <p class="qa">✓ {question.options[question.answer]}</p>
                  {question.explain && <p class="qe">💡 {question.explain}</p>}
                </li>
              ))}
            </ol>
          </div>
        );
      })
    }
  </section>
</Base>

<style>
  .egitmen {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }
  .quiz-block {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 18px 22px;
    margin-bottom: 20px;
    box-shadow: var(--shadow);
  }
  .quiz-block h2 {
    font-size: 17.5px;
    margin: 0 0 8px;
  }
  .quiz-block h2 a {
    color: var(--text);
  }
  .quiz-block h2 a:hover {
    color: var(--accent);
  }
  .qb-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: var(--text-faint);
    margin-bottom: 10px;
  }
  .quiz-block ol {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 10px;
  }
  .quiz-block li {
    list-style: none;
    border-top: 1px dashed var(--border);
    padding-top: 8px;
  }
  .qq {
    margin: 0 0 4px;
    font-weight: 600;
  }
  .qa {
    margin: 0;
    color: var(--ok);
    font-weight: 600;
    font-size: 14.5px;
  }
  .qe {
    margin: 4px 0 0;
    font-size: 13.5px;
    color: var(--text-soft);
  }
</style>
