---
import { getDocsFor, sortLessons, toVM, type Doc, type DocEn, type AnyDoc } from '@lib/content';
import { ui, type Locale } from '@consts';

// Build zamanında üretilen arama indeksi — istemciye gömülür.
interface Props {
  lang?: Locale;
}
const { lang = 'tr' } = Astro.props;
const docs = (await getDocsFor(lang)) as AnyDoc[];
const index = sortLessons(docs as Doc[]).map((d) => {
  const vm = toVM(d, lang);
  return { t: vm.title, d: vm.description, u: vm.url, l: vm.level };
});

// JSON içinde olası bir </script> dizisini güvenle kaçır.
const safeJson = JSON.stringify(index).replaceAll('<', '\\u003c');
const t = ui(lang);
---

<div class="header-search" data-lang={lang}>
  <span class="search-icon" aria-hidden="true">🔍</span>
  <input
    type="search"
    placeholder={t.searchPlaceholder}
    aria-label={lang === 'en' ? 'Search lessons' : 'Derslerde ara'}
    autocomplete="off"
  />
  <div class="search-results" role="listbox" hidden></div>
</div>

<script type="application/json" id="dy-search-index" set:html={safeJson} />

<script>
  type Item = { t: string; d: string; u: string; l: number };

  const box = document.querySelector<HTMLElement>('.header-search')!;
  const lang = box.dataset.lang ?? 'tr';
  const input = box.querySelector<HTMLInputElement>('input')!;
  const panel = box.querySelector<HTMLElement>('.search-results')!;
  const raw = document.getElementById('dy-search-index')?.textContent ?? '[]';
  const index: Item[] = JSON.parse(raw);

  const LEVEL_NAMES =
    lang === 'en'
      ? [
          'Level 0',
          'Level 1 · Foundations',
          'Level 2 · CI/CD',
          'Level 3 · Containers & Cloud',
          'Level 4 · Operations',
          'Level 5 · Mastery',
        ]
      : [
          'Seviye 0',
          'Seviye 1 · Temeller',
          'Seviye 2 · CI/CD',
          'Seviye 3 · Konteyner & Bulut',
          'Seviye 4 · Operasyon',
          'Seviye 5 · Ustalık',
        ];
  const emptyText = lang === 'en' ? 'No results found 🤷' : 'Sonuç bulunamadı 🤷';

  function hidePanel() {
    panel.hidden = true;
    panel.classList.remove('open');
  }

  function render() {
    const q = input.value.trim().toLocaleLowerCase('tr-TR');
    if (q.length < 2) {
      hidePanel();
      panel.innerHTML = '';
      return;
    }
    const hits = index
      .filter((it) => (it.t + ' ' + it.d).toLocaleLowerCase('tr-TR').includes(q))
      .slice(0, 8);
    if (hits.length === 0) {
      panel.innerHTML = `<div class="search-empty">${emptyText}</div>`;
    } else {
      panel.innerHTML = hits
        .map(
          (it) =>
            `<a href="${it.u}"><span class="sr-title">${it.t}</span>` +
            `<span class="sr-meta">${LEVEL_NAMES[it.l] ?? 'Seviye ' + it.l} · ${it.d}</span></a>`
        )
        .join('');
    }
    panel.hidden = false;
    panel.classList.add('open');
  }

  input.addEventListener('input', render);
  input.addEventListener('focus', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      input.value = '';
      hidePanel();
      input.blur();
    }
    if (e.key === 'Enter') {
      const first = panel.querySelector('a');
      if (first) first.click();
    }
  });
  document.addEventListener('click', (e) => {
    if (!box.contains(e.target as Node)) hidePanel();
  });
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      input.focus();
    }
  });
</script>
