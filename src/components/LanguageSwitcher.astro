---
import { withBase, ui, type Locale } from '@consts';

interface Props {
  /** Mevcut sayfanın diğer dildeki karşılığı — yoksa diğer dilin ana sayfası kullanılır. */
  lang: Locale;
  altLangUrl?: string;
}

const { lang, altLangUrl } = Astro.props;
const target = altLangUrl ?? (lang === 'tr' ? withBase('/en/') : withBase('/'));
const label = lang === 'tr' ? 'EN' : 'TR';
const targetLang = lang === 'tr' ? 'en' : 'tr';
const targetName = lang === 'tr' ? 'English version' : 'Türkçe sürüm';
---

<a
  class="lang-switch"
  href={target}
  hreflang={targetLang}
  lang={targetLang}
  title={targetName}
  aria-label={targetName}
>{label}</a>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text);
    font-size: 12.5px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .lang-switch:hover {
    background: var(--accent-soft);
    text-decoration: none;
  }
</style>
